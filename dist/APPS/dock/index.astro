---
// Dock 停靠栏 — Astro 封装组件
// Dock 栏单独重构，负责聚合展示各应用图标入口。
---
<div class="nori-dock" data-app="dock" role="toolbar" aria-label="应用停靠栏">
  <div id="dock-root" class="nori-dock-root"></div>
</div>

<script src="./src/QfrDock-D2m-2E_A.js" type="module"></script>

<style>
  .nori-dock {
    position: fixed;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    background: rgba(22, 26, 43, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    backdrop-filter: blur(12px);
    z-index: 100;
  }
  .nori-dock-root {
    display: flex;
    align-items: center;
    gap: 10px;
  }
</style>